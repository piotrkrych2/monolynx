{
  "enabledPlugins": {
    "monolynx@monolynx": true
  },
  "env": {
    "MONOLYNX_PROJECT_SLUG": "monolynx"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/piotrkrych/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/piotrkrych/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}